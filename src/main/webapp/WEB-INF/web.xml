    <filter>
        <filter-name>AuthAccessFilter</filter-name>
        <filter-class>lk.cypher.bookliy.middleware.AuthAccessFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AdminAuthAccessFilter</filter-name>
        <filter-class>lk.cypher.bookliy.middleware.admin.AdminAuthAccessFilter</filter-class>
    </filter>

    <!--  User  -->
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/sign-up.html</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/sign-in.html</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/verify-account.html</url-pattern>
    </filter-mapping>
    <!--  User  -->

    <!--  Admin  -->
    <filter-mapping>
        <filter-name>AdminAuthAccessFilter</filter-name>
        <url-pattern>/admin-sign-in.html</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AccessControllFilter</filter-name>
        <filter-class>lk.cypher.bookliy.middleware.AccessControllFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AccessControllFilter</filter-name>
        <url-pattern>/my-account.html</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminAccessControllFilter</filter-name>
        <filter-class>lk.cypher.bookliy.middleware.admin.AdminAccessControllFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>AdminAccessControllFilter</filter-name>
        <url-pattern>/admin-panel.html</url-pattern>
    </filter-mapping>
</web-app>